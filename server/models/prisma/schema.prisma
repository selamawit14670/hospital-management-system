// MediCare Hospital Management System
// Prisma Schema for PostgreSQL
// Prepared for upcoming clinical data modeling phases

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

